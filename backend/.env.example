# Copy this file to .env for local dev, or set these as real environment
# variables in your hosting platform's dashboard (Render, Railway, etc).

ENV=development

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Local dev default is SQLite. In production set this to your Postgres connection string,
# e.g. postgresql://user:password@host:5432/dbname (Render/Railway provide this automatically).
DATABASE_URL=sqlite:///./bharatvoice.db

# Comma-separated list of allowed frontend origins. Use "*" only for local dev.
# e.g. https://your-app.netlify.app,http://localhost:5173
CORS_ORIGINS=*

# Where uploaded proof photos are stored. On Render, point this at your mounted persistent disk,
# e.g. /var/data/uploads. Defaults to ./uploads next to this file.
UPLOAD_DIR=

# Max proof-photo upload size in bytes. Defaults to 5MB.
MAX_UPLOAD_BYTES=5242880
